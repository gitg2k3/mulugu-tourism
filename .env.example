# ==============================================================================
# DISCOVER MULUGU - ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================

# Website & CMS URLs
# In production on Vercel: Set to your custom domain (e.g., https://discovermulugu.org)
# Or leave blank if you want the app to auto-detect your VERCEL_PROJECT_PRODUCTION_URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Discover Mulugu"
NEXT_PUBLIC_SITE_DESCRIPTION="Independent Eco-Tourism & Cultural Guide for Mulugu, Telangana"

# Payload CMS Secret (Required - Minimum 32 random characters)
# Generate a secure secret using: openssl rand -base64 32
PAYLOAD_SECRET=your-secure-payload-secret-at-least-32-chars-long

# PostgreSQL Connection String for Payload CMS (Required for CMS)
# Use a serverless PostgreSQL database such as Neon (neon.tech), Supabase (supabase.com), or Vercel Postgres.
#
# Examples:
# Neon:      postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# Supabase:  postgresql://postgres.xxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
# Local:     postgresql://postgres:password@127.0.0.1:5432/discover_mulugu
DATABASE_URI=postgresql://postgres:your_password@127.0.0.1:5432/discover_mulugu
